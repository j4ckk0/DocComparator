<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.jtools</groupId>
  <artifactId>doccomparator-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>DocComparator (parent)</name>
  <description>See what changed between two documents — Word, Excel, PDF, text: side by side, paragraph by paragraph, the text first and each kind of layout on its own switch. Three jars: the comparison (doccomparator-core), its view (doccomparator-ui), the program (doccomparator).</description>
  <url>https://github.com/j4ckk0/DocComparator</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>jtools.org</name>
    <url>https://github.com/j4ckk0</url>
  </organization>

  <!-- What Maven Central asks of every project it holds: its licence, who makes it, where its sources are
       (PUBLISHING.md, section 2). -->
  <licenses>
    <license>
      <name>Apache License Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>j4ckk0</id>
      <name>Jacques HENRY</name>
      <email>j4ckk057@gmail.com</email>
      <organization>jtools.org</organization>
      <organizationUrl>https://github.com/j4ckk0</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/j4ckk0/DocComparator.git</connection>
    <developerConnection>scm:git:git@github.com:j4ckk0/DocComparator.git</developerConnection>
    <url>https://github.com/j4ckk0/DocComparator</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/j4ckk0/DocComparator/issues</url>
  </issueManagement>

  <!-- Built in this order, each a jar and a Java module: the comparison, its view, the program (README, "Layout");
       then the examples, programs showing a developer how the libraries are used, built with the rest so they never
       go stale, and never published. -->
  <modules>
    <module>doccomparator-core</module>
    <module>doccomparator-ui</module>
    <module>doccomparator-app</module>
    <module>examples</module>
  </modules>

  <properties>
    <revision>3.0</revision>
    <!-- The same version in the four parts Windows wants of an .exe (launch4j refuses anything else). -->
    <windowsVersion>3.0.0.0</windowsVersion>
    <!-- The one library shipped, a decision taken knowingly (README, "No network"): its classes read by
         NoNetworkTest at each build. Another version is another decision: the enforcer rule names this one. -->
    <flatlaf.version>3.7.2</flatlaf.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jtools</groupId>
        <artifactId>doccomparator-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <!-- core's tests' helpers, I18nEnglishInTests among them: the other modules' tests speak English too -->
        <groupId>org.jtools</groupId>
        <artifactId>doccomparator-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.jtools</groupId>
        <artifactId>doccomparator-ui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <!-- The window's looks, a dark one among them: the program's alone -->
        <groupId>com.formdev</groupId>
        <artifactId>flatlaf</artifactId>
        <version>${flatlaf.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.12.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
          <configuration>
            <archive>
              <manifest>
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>3.7.1</version>
        </plugin>
        <plugin>
          <groupId>com.akathist.maven.plugins.launch4j</groupId>
          <artifactId>launch4j-maven-plugin</artifactId>
          <version>2.7.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!-- Apache 2.0 header at the top of every Java source (same convention as the jtools projects) -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.4.0</version>
        <configuration>
          <verbose>false</verbose>
          <licenseName>apache_v2</licenseName>
          <organizationName>jtools.org</organizationName>
          <inceptionYear>2026</inceptionYear>
          <canUpdateCopyright>true</canUpdateCopyright>
        </configuration>
        <executions>
          <execution>
            <id>add-license-headers</id>
            <phase>process-sources</phase>
            <goals>
              <goal>update-file-header</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/*.java</include>
              </includes>
              <roots>
                <root>src/main/java</root>
                <root>src/test</root>
              </roots>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Nothing ships but the three modules' classes, FlatLaf's and the JRE: NoNetworkTest reads those only,
             so another library would bring code it never checks (README, "No network"). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>no-shipped-library</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                    <exclude>*:*:*:*:system</exclude>
                  </excludes>
                  <includes>
                    <!-- the jars of this build, each read by NoNetworkTest -->
                    <include>org.jtools:doccomparator-core:${project.version}</include>
                    <include>org.jtools:doccomparator-ui:${project.version}</include>
                    <!-- read by NoNetworkTest, this version only -->
                    <include>com.formdev:flatlaf:${flatlaf.version}</include>
                  </includes>
                  <message>DocComparator ships no library but FlatLaf, this version: another would carry code NoNetworkTest does not read (README, "No network").</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <compilerArgs>
                <!-- the version the program shows when it runs from the distributions' runtime image -->
                <arg>--module-version</arg>
                <arg>${project.version}</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- the tests on the class path, as the jar runs: module-info.java is for the runtime image -->
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The distribution of the system that builds, for the program's dist profile (doccomparator-app):
         jlink links only for its own. -->
    <profile>
      <id>dist-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <dist.system>windows</dist.system>
        <launch4j.skip>false</launch4j.skip>
        <exe>.exe</exe>
      </properties>
    </profile>
    <profile>
      <id>dist-linux</id>
      <activation>
        <os>
          <family>unix</family>
        </os>
      </activation>
      <properties>
        <dist.system>linux</dist.system>
        <launch4j.skip>true</launch4j.skip>
        <exe></exe>
      </properties>
    </profile>

    <!--
      mvn -Ppublish deploy
      Publishes DocComparator on Maven Central through the Central Portal (PUBLISHING.md, section 2): the parent
      pom and each module's jar, its own classes only, the other modules and FlatLaf its dependencies rather than
      held in it; their sources and javadoc; each pom with its version written out; each signed. Needs the
      portal's token as the server "central" in ~/.m2/settings.xml and a GPG key whose public part is on a key
      server. The upload is validated but not
      released until it is published from the portal. Only with this profile: the other builds reach for none of
      these plugins.
    -->
    <profile>
      <id>publish</id>
      <build>
        <plugins>
          <plugin>
            <!-- ${revision} written out in the pom deployed: Maven resolves it in this build only -->
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>flatten-maven-plugin</artifactId>
            <version>1.8.0</version>
            <configuration>
              <flattenMode>resolveCiFriendliesOnly</flattenMode>
              <updatePomFile>true</updatePomFile>
              <outputDirectory>${project.build.directory}</outputDirectory>
            </configuration>
            <executions>
              <execution>
                <id>flatten</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>flatten</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <configuration>
              <!-- the comments say what each part is for; not every parameter has its @param -->
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- signs each file with the GPG key of the one publishing (-Dgpg.keyname= if several) -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- uploads to the Central Portal, its token in ~/.m2/settings.xml under the server "central"; published
                 by hand from https://central.sonatype.com once its checks pass -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <!-- at least this one: older versions fail on a field of the portal's status answer (PUBLISHING.md) -->
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <!-- the examples are read and run from the repository, not taken from Maven Central -->
              <excludeArtifacts>
                <excludeArtifact>doccomparator-examples</excludeArtifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
