<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.jtools</groupId>
  <artifactId>doccomparator</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>DocComparator</name>
  <description>See what changed between two Word documents (.docx): side by side, paragraph by paragraph, the text first and each kind of layout on its own switch. A desktop program with its own Java runtime that never reaches the network.</description>
  <url>https://github.com/j4ckk0/DocComparator</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>jtools.org</name>
    <url>https://github.com/j4ckk0</url>
  </organization>

  <!-- What Maven Central asks of every project it holds: its licence, who makes it, where its sources are
       (PUBLISHING.md, section 7). -->
  <licenses>
    <license>
      <name>Apache License Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>j4ckk0</id>
      <name>Jacques HENRY</name>
      <email>j4ckk057@gmail.com</email>
      <organization>jtools.org</organization>
      <organizationUrl>https://github.com/j4ckk0</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/j4ckk0/DocComparator.git</connection>
    <developerConnection>scm:git:git@github.com:j4ckk0/DocComparator.git</developerConnection>
    <url>https://github.com/j4ckk0/DocComparator</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/j4ckk0/DocComparator/issues</url>
  </issueManagement>

  <properties>
    <revision>1.7</revision>
    <!-- The same version in the four parts Windows wants of an .exe (launch4j refuses anything else). -->
    <windowsVersion>1.7.0.0</windowsVersion>
    <!-- The one library shipped, a decision taken knowingly (README, "No network"): its classes read by
         NoNetworkTest at each build. Another version is another decision: the enforcer rule names this one. -->
    <flatlaf.version>3.7.2</flatlaf.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <!-- The window's looks, a dark one among them -->
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>${flatlaf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.12.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>doccomparator</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The program's own licence, inside it: Help ▸ Licence shows it, with nothing else to open. -->
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>org/jtools/doccomparator</targetPath>
        <includes>
          <include>LICENSE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- Apache 2.0 header at the top of every Java source (same convention as the jtools projects) -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.4.0</version>
        <configuration>
          <verbose>false</verbose>
          <licenseName>apache_v2</licenseName>
          <organizationName>jtools.org</organizationName>
          <inceptionYear>2026</inceptionYear>
          <canUpdateCopyright>true</canUpdateCopyright>
        </configuration>
        <executions>
          <execution>
            <id>add-license-headers</id>
            <phase>process-sources</phase>
            <goals>
              <goal>update-file-header</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/*.java</include>
              </includes>
              <roots>
                <root>src/main/java</root>
                <root>src/test</root>
              </roots>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Nothing ships but the program's own classes and the JRE: NoNetworkTest reads the program's classes
             only, so a library would bring code it never checks (README, "No network"). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>no-shipped-library</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                    <exclude>*:*:*:*:system</exclude>
                  </excludes>
                  <includes>
                    <!-- read by NoNetworkTest, this version only -->
                    <include>com.formdev:flatlaf:${flatlaf.version}</include>
                  </includes>
                  <message>DocComparator ships no library but FlatLaf, this version: another would carry code NoNetworkTest does not read (README, "No network").</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.jtools.doccomparator.Launcher</mainClass>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!-- doccomparator.jar holds FlatLaf's classes too: one jar, the launchers as they are. Not its native
             libraries, which it would unpack in a temporary directory: the program does without them. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>com.formdev:flatlaf</artifact>
                  <excludes>
                    <exclude>com/formdev/flatlaf/natives/**</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <!-- FlatLaf's classes for later Javas, in META-INF/versions -->
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn package -Pdist
      Builds the self-contained distributions, each with a bundled JRE (external/jre-windows.zip and
      external/jre-linux.tar.gz, deployed by scripts/setup.sh, not tracked) and launchers, into releases/
      (not tracked, kept by mvn clean; the previous versions' releases are removed by scripts/package.*):
        releases/doccomparator-<version>-windows.zip    DocComparator.exe, doccomparator.bat
        releases/doccomparator-<version>-linux.tar.gz   doccomparator.sh
    -->
    <profile>
      <id>dist</id>
      <properties>
        <jre.archives>${project.basedir}/external</jre.archives>
        <jre.windows>jre-windows.zip</jre.windows>
        <jre.linux>jre-linux.tar.gz</jre.linux>
        <jre.unpacked>${project.build.directory}/jre</jre.unpacked>
        <release.dir>${project.basedir}/releases</release.dir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>unpack-jre</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <fail message="no ${jre.archives}/${jre.windows}: run scripts/setup.sh (see README: Externals)">
                      <condition>
                        <not><available file="${jre.archives}/${jre.windows}"/></not>
                      </condition>
                    </fail>
                    <fail message="no ${jre.archives}/${jre.linux}: run scripts/setup.sh (see README: Externals)">
                      <condition>
                        <not><available file="${jre.archives}/${jre.linux}"/></not>
                      </condition>
                    </fail>
                    <!-- cutdirsmapper strips the archives' top-level "jdk-xx-jre/" directory -->
                    <unzip dest="${jre.unpacked}/windows">
                      <fileset dir="${jre.archives}" includes="${jre.windows}"/>
                      <cutdirsmapper dirs="1"/>
                    </unzip>
                    <untar dest="${jre.unpacked}/linux" compression="gzip">
                      <fileset dir="${jre.archives}" includes="${jre.linux}"/>
                      <cutdirsmapper dirs="1"/>
                    </untar>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- DocComparator.exe: a Windows launcher without a console (GUI subsystem) that runs the bundled
                 jre\ with doccomparator.jar; built from any OS. doccomparator.bat keeps the console. -->
            <groupId>com.akathist.maven.plugins.launch4j</groupId>
            <artifactId>launch4j-maven-plugin</artifactId>
            <version>2.7.0</version>
            <executions>
              <execution>
                <id>windows-launcher</id>
                <phase>package</phase>
                <goals>
                  <goal>launch4j</goal>
                </goals>
                <configuration>
                  <headerType>gui</headerType>
                  <outfile>${project.build.directory}/DocComparator.exe</outfile>
                  <dontWrapJar>true</dontWrapJar>
                  <jar>doccomparator.jar</jar>
                  <chdir>.</chdir>
                  <errTitle>DocComparator</errTitle>
                  <jre>
                    <path>jre</path>
                    <requiresJdk>false</requiresJdk>
                    <requires64Bit>true</requires64Bit>
                    <minVersion>21</minVersion>
                    <opts>
                      <!-- the JVM's performance counters in memory, not in a file of %TEMP% -->
                      <opt>-XX:-UsePerfData</opt>
                    </opts>
                  </jre>
                  <versionInfo>
                    <fileVersion>${windowsVersion}</fileVersion>
                    <txtFileVersion>${project.version}</txtFileVersion>
                    <fileDescription>DocComparator</fileDescription>
                    <copyright>jtools.org</copyright>
                    <productVersion>${windowsVersion}</productVersion>
                    <txtProductVersion>${project.version}</txtProductVersion>
                    <productName>DocComparator</productName>
                    <internalName>doccomparator</internalName>
                    <originalFilename>DocComparator.exe</originalFilename>
                  </versionInfo>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <version>3.7.1</version>
            <executions>
              <execution>
                <id>dist</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <finalName>${project.artifactId}-${project.version}</finalName>
                  <appendAssemblyId>true</appendAssemblyId>
                  <!-- not artifacts of the project: never deployed (a release would upload the JREs) -->
                  <attach>false</attach>
                  <outputDirectory>${release.dir}</outputDirectory>
                  <descriptors>
                    <descriptor>src/assembly/windows.xml</descriptor>
                    <descriptor>src/assembly/linux.xml</descriptor>
                  </descriptors>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      mvn -Ppublish deploy
      Publishes DocComparator on Maven Central through the Central Portal (PUBLISHING.md, section 7): the
      program's own jar, FlatLaf a dependency of it rather than held in it; its sources and javadoc; the pom with
      its version written out; each signed. Needs the portal's token as the server "central" in
      ~/.m2/settings.xml and a GPG key whose public part is on a key server. The upload is validated but not
      released until it is published from the portal. Only with this profile: the other builds reach for none of
      these plugins.
    -->
    <profile>
      <id>publish</id>
      <build>
        <plugins>
          <plugin>
            <!-- the jar of Maven Central: the program's classes, FlatLaf named by the pom, not held twice -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <executions>
              <execution>
                <id>default</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- ${revision} written out in the pom deployed: Maven resolves it in this build only -->
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>flatten-maven-plugin</artifactId>
            <version>1.8.0</version>
            <configuration>
              <flattenMode>resolveCiFriendliesOnly</flattenMode>
              <updatePomFile>true</updatePomFile>
              <outputDirectory>${project.build.directory}</outputDirectory>
            </configuration>
            <executions>
              <execution>
                <id>flatten</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>flatten</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <configuration>
              <!-- the comments say what each part is for; not every parameter has its @param -->
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- signs each file with the GPG key of the one publishing (-Dgpg.keyname= if several) -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- uploads to the Central Portal, its token in ~/.m2/settings.xml under the server "central"; published
                 by hand from https://central.sonatype.com once its checks pass -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <!-- 0.7.0 could not read the field the portal added to its status answer (XsdViewer, PUBLISHING.md) -->
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
