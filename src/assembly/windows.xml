<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows distribution: zip with the bundled JRE, DocComparator.exe (no console) and doccomparator.bat (console). -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
  <id>windows</id>
  <formats>
    <format>zip</format>
  </formats>
  <baseDirectory>${project.artifactId}-${project.version}</baseDirectory>

  <files>
    <file>
      <source>${project.build.directory}/${project.build.finalName}.jar</source>
      <destName>doccomparator.jar</destName>
    </file>
    <file>
      <source>${project.build.directory}/DocComparator.exe</source>
    </file>
    <file>
      <source>src/dist/doccomparator.bat</source>
      <lineEnding>crlf</lineEnding>
    </file>
    <file>
      <!-- the program's licence, and what it holds of others' -->
      <source>LICENSE</source>
      <lineEnding>crlf</lineEnding>
    </file>
    <file>
      <source>NOTICE</source>
      <lineEnding>crlf</lineEnding>
    </file>
    <file>
      <!-- the licence of FlatLaf, whose classes doccomparator.jar holds -->
      <source>src/dist/licenses/FlatLaf-LICENSE.txt</source>
      <outputDirectory>licenses</outputDirectory>
    </file>
    <file>
      <source>README.md</source>
      <lineEnding>crlf</lineEnding>
    </file>
  </files>

  <fileSets>
    <fileSet>
      <directory>${project.build.directory}/jre/windows</directory>
      <outputDirectory>jre</outputDirectory>
    </fileSet>
  </fileSets>
</assembly>
